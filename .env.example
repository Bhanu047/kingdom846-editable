# Kingdom 846 Portal — environment variables (all optional for local testing)

# Secret used to sign login tokens. Set to a long random string in production.
# If unset, the server falls back to a default (fine for local testing only).
SESSION_SECRET=change-me-to-a-long-random-secret

# Where the SQLite database file lives. Default: ./data.db (created automatically).
# On cloud, point this at a persistent volume, e.g. /var/data/data.db
DB_PATH=./data.db

# Port the server listens on. Default: 5000
PORT=5000
