# Database backups — these are copies of the live data, never committed.
backups/
*.db.part

# TLS private keys and certificates. Never committed: a key that reaches git
# history is a key that has to be reissued, because rewriting history does not
# recall the clones that already have it.
*.key
*.pem
*.p12
*.pfx
