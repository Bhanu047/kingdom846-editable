<?xml version="1.0" encoding="UTF-8"?>
<!--
  One URL, on purpose.

  This listed eleven: the root plus ten fragments (#dashboard, #alliances and
  the rest). Search engines discard everything from the "#" onward, so all ten
  resolved to the root and the sitemap declared the same page eleven times.
  They did not even match the app's real routes, which carry a slash.

  The portal is a hash-routed single page, so there is exactly one URL a
  crawler can fetch. Listing that honestly beats padding the file with
  duplicates. Giving the sections their own indexable URLs needs real paths
  plus prerendering or SSR, which is an app change, not a sitemap change.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://kingdom846.com/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
